MARKETING_VERSION = 1.3.0
CURRENT_PROJECT_VERSION = 7

// Guard betiği bunu okur: değer target'a ulaşmıyorsa base configuration
// hiç bağlanmamış demektir (sessizce yanlış sürümle build edilirdi).
XB_VERSION_SOURCE = xcconfig
