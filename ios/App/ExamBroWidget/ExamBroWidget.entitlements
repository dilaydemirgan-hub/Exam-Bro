<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ana uygulama ile paylaşılan konteyner. App.entitlements
	     ile BİREBİR aynı olmak zorunda; ikisi de WidgetBridge.appGroup ve
	     SharedStore.appGroup sabitleriyle eşleşir. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.exambroapp.sinav</string>
	</array>
</dict>
</plist>
